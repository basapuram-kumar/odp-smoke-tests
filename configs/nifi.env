#
# Used by ./nifi-sample-smoke.sh
# Everything here is optional; the script discovers it from Ambari.

# Skip Ambari discovery of the NiFi host / port / TLS flag.
# NIFI_URL=http://nifi-host:9090
# NIFI_URL=https://nifi-host:9091

# NiFi refuses user authentication over plain HTTP, so SPNEGO is only used
# when NIFI_URL is https. Leave the kinit off unless you actually need it.
# NIFI_SKIP_KINIT=1
# NIFI_KEYTAB=/etc/security/keytabs/nifi.service.keytab
# NIFI_PRINCIPAL=nifi/nifi-host

# NIFI_SKIP_WRITE=0
# NIFI_KEEP_FLOW=0
# NIFI_PG_NAME=odp_smoke_pg
# NIFI_PROCESSOR_TYPE=org.apache.nifi.processors.standard.GenerateFlowFile

# CURL_EXTRA_OPTS=-k
