#
# Used by ./jupyterhub-sample-smoke.sh
# Everything here is optional; the script discovers it from Ambari
# (JUPYTER service: port, enable_ssl, initial_admin, dummy_password, and
# c.JupyterHub.base_url out of the rendered jupyterhub_config.py).

# Skip Ambari discovery of the hub host / port / TLS flag.
# JUPYTERHUB_URL=http://jupyterhub-host:8000

# JupyterHub is often mounted under a prefix; "/" when it is not.
# JUPYTERHUB_BASE_URL=/lab

# Login used for the authenticated checks. With DummyAuthenticator this is the
# shared dummy password. Prefer setting it here over exporting it on the shell.
# JUPYTERHUB_USER=jupyterhub
# JUPYTERHUB_PASSWORD=REPLACE_ME

# JUPYTERHUB_SKIP_SPAWN=0
# JUPYTERHUB_KEEP_SERVER=0
# JUPYTERHUB_SPAWN_TIMEOUT=120
# JUPYTERHUB_POLL_SECONDS=5

# CURL_EXTRA_OPTS=-k
