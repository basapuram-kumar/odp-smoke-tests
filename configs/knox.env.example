# Copy to knox.env (gitignored) and adjust if needed.
#   cp configs/knox.env.example configs/knox.env
#
# Used by ./knox-sample-smoke.sh
# Everything here is optional; the script discovers it from Ambari
# (KNOX service: KNOX_GATEWAY host, gateway.port, gateway.path, the topology's
# LDAP realm URL, and the demo users-ldif credentials).

# Skip Ambari discovery of the gateway host / port / path.
# KNOX_URL=https://knox-host:8443/gateway

# Topologies expected to be deployed, as <topology>=<service-path> pairs. Knox
# only routes paths a topology declares as a service, so an unmapped path 404s
# exactly like an undeployed topology - the probe has to hit a real service.
# KNOX_TOPOLOGY_PROBES=admin=/api/v1/version default=/webhdfs/v1/?op=LISTSTATUS knoxsso=/api/v1/websso manager=/admin-ui/ homepage=/home metadata=/api/v1/metadata

# Login used for the admin API and the proxied WebHDFS call. On a stock ODP
# install these come from the Knox demo LDAP (users-ldif), which the script
# reads from Ambari. Set them here to use a real identity store instead.
# KNOX_USER=admin
# KNOX_PASSWORD=REPLACE_ME

# Identity store behind the topology's authentication provider. Used only to
# tell "wrong password" apart from "the store is down".
# KNOX_LDAP_URL=ldap://knox-host:33389

# KNOX_SKIP_AUTH=0
# KNOX_SKIP_WEBHDFS=0
# KNOX_WEBHDFS_TOPOLOGY=default

# Knox ships a self-signed certificate, so -k is the default.
# CURL_EXTRA_OPTS=-k
