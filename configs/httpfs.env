#
# Used by ./httpfs-sample-smoke.sh and ./setups/setup-httpfs.sh
#

# Optional: skip Ambari discovery
# HTTPFS_HOST=odp1
# HTTPFS_PORT=14000
# HTTPFS_URL=http://odp1:14000/webhdfs/v1/?op=LISTSTATUS

# Kerberos (setup creates these when KDC is local)
# HTTPFS_PRINCIPAL=httpfs/odp1@ADSRE.COM
# HTTPFS_KEYTAB=/etc/security/keytabs/httpfs.service.keytab

# SSH to HttpFS / KDC host for setups/setup-httpfs.sh
# SSH_USER=acceldata
# SSH_KEY=$HOME/Downloads/usdc.pem

# HTTPFS_RUN_SETUP=1
# HTTPFS_SKIP_KEYTAB=0
# HTTPFS_SKIP_START=0
