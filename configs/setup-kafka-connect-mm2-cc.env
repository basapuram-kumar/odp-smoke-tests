# Optional defaults for setups/setup-kafka-connect-mm2-cc.sh
# Ambari URL/user/password still come from configs/ambari.env unless overridden here.

# auto | kafka | kafka3
KAFKA_FLAVOR=auto

# MM2 destination bootstrap (required unless set on CLI)
MM2_DEST_BOOTSTRAP_SERVERS=rl8kmm2n1:6667
MM2_DEST_SECURITY_PROTOCOL=PLAINTEXT
MM2_DEST_CLUSTER_ALIAS=dest
MM2_TOPICS=.*

# Single-node friendly defaults
KAFKA_REPLICATION_FACTOR=1
KAFKA_MIN_INSYNC_REPLICAS=1
KAFKA_DISABLE_RANGER_PLUGIN=true
KAFKA_KERBEROS_REALM=ADSRE.COM

# Host prep over SSH (dest /etc/hosts + optional CredentialUtil.jar)
SETUP_HOST_ENABLED=true
SETUP_SSH_USER=acceldata
SETUP_SSH_KEY=~/Downloads/usdc.pem
# empty = Ambari host IP discovered from the cluster
SETUP_SSH_HOST=
SETUP_DEST_HOSTS_ENTRY=10.101.11.158 rl8kmm2n1 rl8kmm2n1
# optional source host that already has CredentialUtil.jar
SETUP_COPY_CREDENTIAL_UTIL_FROM=10.101.11.134

# Operations
SETUP_INSTALL_COMPONENTS=true
SETUP_APPLY_CONFIGS=true
SETUP_RESTART_BROKER=true
SETUP_START_COMPONENTS=true
SETUP_WAIT_TIMEOUT_SEC=900
