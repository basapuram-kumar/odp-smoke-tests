# Optional defaults for setups/setup-kafka-connect-mm2-cc.sh
# Ambari URL/user/password still come from configs/ambari.env unless overridden here.

# auto | kafka | kafka3 | both
KAFKA_FLAVOR=both

# MM2 destination: host or host:port.
# For flavor=both, host-only is preferred (script adds :6667 / :6669 per flavor).
MM2_DEST_BOOTSTRAP_SERVERS=10.101.11.106
MM2_DEST_SECURITY_PROTOCOL=PLAINTEXT
MM2_DEST_CLUSTER_ALIAS=dest
MM2_TOPICS=.*

# Single-node friendly defaults
KAFKA_REPLICATION_FACTOR=1
KAFKA_MIN_INSYNC_REPLICAS=1
KAFKA_DISABLE_RANGER_PLUGIN=true
KAFKA_KERBEROS_REALM=ADSRE.COM

# Host prep over SSH (dest /etc/hosts + CredentialUtil.jar)
SETUP_HOST_ENABLED=true
SETUP_SSH_USER=acceldata
SETUP_SSH_KEY=~/Downloads/usdc.pem
# empty = placement host IP discovered from the cluster
SETUP_SSH_HOST=
# Optional: "IP alias ..." for dest resolution from source hosts
SETUP_DEST_HOSTS_ENTRY=10.101.11.106 kmm31 10.101.11.106

# Operations
SETUP_INSTALL_COMPONENTS=true
SETUP_APPLY_CONFIGS=true
SETUP_RESTART_BROKER=true
SETUP_START_COMPONENTS=true
SETUP_WAIT_TIMEOUT_SEC=900

# Kerberos (preferred via env): export ODP_KDC_PASSWORD='...'
# ODP_KDC_PRINCIPAL=admin/admin@ADSRE.COM
