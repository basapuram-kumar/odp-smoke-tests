#
# Used by ./hue-sample-smoke.sh and ./setups/setup-hue.sh
#
# Cluster example (override Ambari via env or configs/ambari.env):
#   AMBARI_BASE_URL=http://10.101.11.47:8080
#

# Optional: skip Ambari discovery
# HUE_URL=http://10.101.11.47:8888
# HUE_HOST=odp1
# HUE_PORT=8888
# HUE_SSL=0

# Form login (AllowFirstUserDjangoBackend / ModelBackend)
# Prefer a dedicated smoke admin; setups/setup-hue.sh can create/reset it.
HUE_USER=admin
HUE_PASSWORD=admin

# Optional setup (MySQL metastore + keytab + migrate + Ambari START)
# HUE_RUN_SETUP=1
SSH_USER=acceldata
# SSH_KEY=$HOME/Downloads/usdc.pem
HUE_DB_HOST=odp1
HUE_DB_NAME=hue
HUE_DB_USER=hue
HUE_DB_PASS=hue
# HUE_PRINCIPAL=hue-odp@ADSRE.COM
HUE_KEYTAB=/etc/security/keytabs/hue.headless.keytab

# HUE_SKIP_AUTH=0
# CURL_EXTRA_OPTS=-k
