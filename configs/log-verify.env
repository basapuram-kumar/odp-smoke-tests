# Cluster service/component log verification defaults.
# Override any value on the command line or via shell export.
#
# Ambari host/URL/user/password come from configs/ambari.env
# (do not set AMBARI_BASE_URL here). Cluster hosts are discovered from Ambari.

# SSH into cluster hosts discovered from Ambari (hostname/IP from Ambari API).
SSH_USER=acceldata
# Leave empty to use ssh default identity (~/.ssh/id_rsa) / agent.
# Or set to a PEM/path, e.g. SSH_KEY=/root/Downloads/usdc.pem
SSH_KEY=
SSH_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=15"

# 1 = restart each STARTED host-component via Ambari, then re-check logs
# 0 = verify existing logs only (no restart)
# WARNING: restart=1 walks every STARTED component sequentially and is disruptive.
LOG_VERIFY_RESTART=0

# Comma/space list to limit scope (empty = all STARTED non-client components)
# LOG_VERIFY_SERVICES=HDFS,YARN,ZOOKEEPER
# LOG_VERIFY_SKIP_SERVICES=KERBEROS,TEZ,SQOOP
# LOG_VERIFY_COMPONENTS=NAMENODE,DATANODE
# LOG_VERIFY_HOSTS=

# Treat logs with mtime older than this (hours) as stale when not restarting
LOG_STALE_HOURS=24

# Seconds to wait after Ambari marks component STARTED before checking logs
LOG_SETTLE_SECONDS=20

# Max Ambari request wait for stop/start/restart
LOG_RESTART_TIMEOUT_SECONDS=600

# Capture last N log lines for ERROR/FATAL/Exception samples
LOG_ERROR_TAIL_LINES=200
LOG_ERROR_SAMPLE_MAX=8

# Report paths (relative to odp-smoke-tests/ unless absolute)
LOG_VERIFY_REPORT_DIR=reports/log-verify
