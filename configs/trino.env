#
# Used by ./setups/setup-trino.sh and ./trino-sample-smoke.sh
#

# Optional: skip Ambari discovery
# TRINO_COORDINATOR_HOST=odp2
# TRINO_HTTP_PORT=9097
# TRINO_URL=http://odp2:9097/v1/info

# Kerberos / SSL (setup fills these when missing)
# TRINO_KEYTAB=/etc/security/keytabs/trino.keytab
# TRINO_SHARED_KEY=   # auto-generated when empty on Kerberos clusters
# TRINO_DISABLE_EMPTY_SSL=1

# SSH to Trino / KDC hosts for package + keytab repair
# SSH_USER=acceldata
# SSH_KEY=$HOME/Downloads/usdc.pem

# TRINO_RUN_SETUP=1
# TRINO_SKIP_KEYTAB=0
# TRINO_SKIP_PACKAGE=0
# TRINO_SKIP_CONFIG=0
# TRINO_SKIP_START=0
