# Copy to druid.env (gitignored) and adjust if needed.
#   cp configs/druid.env.example configs/druid.env
#
# Used by ./druid-sample-smoke.sh

# Optional: skip Ambari discovery of role hosts
# DRUID_BROKER_URL=http://broker-host:8082
# DRUID_COORDINATOR_URL=http://coordinator-host:9081
# DRUID_OVERLORD_URL=http://overlord-host:8090
# DRUID_ROUTER_URL=http://router-host:9888

# DRUID_SKIP_KINIT=0
# DRUID_KEYTAB=/etc/security/keytabs/druid.headless.keytab
# DRUID_DATASOURCE=odp_druid_smoke
# DRUID_SKIP_INGEST=0
# DRUID_KEEP_DATASOURCE=1
# DRUID_TIMEOUT_SECONDS=600
