# Copy to infra-solr.env (gitignored) and adjust if needed.
#   cp configs/infra-solr.env.example configs/infra-solr.env
#
# Used by ./infra-solr-sample-smoke.sh
# Everything here is optional; the script discovers it from Ambari
# (AMBARI_INFRA_SOLR service: INFRA_SOLR hosts, infra_solr_port,
# infra_solr_ssl_enabled, infra_solr_znode, infra_solr_kerberos_keytab).

# Skip Ambari discovery of the Solr topology. INFRA_SOLR_HOSTS is space-separated
# and every host is probed for liveness; the first one serves the admin calls.
# INFRA_SOLR_HOSTS=solr-host-1 solr-host-2
# INFRA_SOLR_PORT=8886
# INFRA_SOLR_SSL=0
# INFRA_SOLR_ZNODE=/infra-solr

# Kerberos identity for the SPNEGO-protected HTTP endpoints. The keytab holds
# host-scoped principals (infra-solr/<fqdn>@REALM) while Ambari only stores the
# _HOST template, so the script scans klist -kt for a matching entry (any field;
# column layout varies by krb5/locale) and falls back to expanding Ambari's
# _HOST template. The keytab is mode 0400 and owned by infra-solr, which is why
# the script normally runs under sudo. A missing identity makes authenticated
# checks SKIPPED (HTTP 401), not FAIL.
# INFRA_SOLR_KEYTAB=/etc/security/keytabs/ambari-infra-solr.service.keytab
# INFRA_SOLR_PRINCIPAL=infra-solr/solr-host-1@EXAMPLE.COM
# INFRA_SOLR_SKIP_KINIT=0

# Second identity used only for the write path's query read-back. security.json
# grants the Solr "read" permission to the "dev" role, and infra-solr holds
# "admin" alone - it can create, index into and drop a collection but cannot
# /select from one. These are the identities the stock user-role map puts in
# "dev"; the first readable keytab wins. Without one the query is SKIPPED.
# INFRA_SOLR_READ_CANDIDATES=/etc/security/keytabs/rangeradmin.service.keytab /etc/security/keytabs/logsearch.service.keytab /etc/security/keytabs/atlas.service.keytab
# INFRA_SOLR_READ_KEYTAB=/etc/security/keytabs/rangeradmin.service.keytab
# INFRA_SOLR_READ_PRINCIPAL=rangeradmin/solr-host-1@EXAMPLE.COM

# Write path: create a throwaway collection, index documents, query them back,
# then delete it. INFRA_SOLR_CONFIGSET defaults to _default when the cluster
# lists it, since its managed schema accepts arbitrary fields.
# INFRA_SOLR_SKIP_WRITE=0
# INFRA_SOLR_COLLECTION=odp_solr_smoke_1700000000
# INFRA_SOLR_CONFIGSET=_default
# INFRA_SOLR_DOC_COUNT=3
# INFRA_SOLR_KEEP_COLLECTION=0

# Set -k when infra_solr_ssl_enabled is true and Solr uses a self-signed cert.
# CURL_EXTRA_OPTS=-k
