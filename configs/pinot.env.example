# Copy to pinot.env (gitignored) and adjust if needed.
#   cp configs/pinot.env.example configs/pinot.env
#
# Used by ./pinot-sample-smoke.sh

# Optional: skip Ambari discovery of role hosts
# PINOT_CONTROLLER_URL=http://controller-host:9000
# PINOT_BROKER_URL=http://broker-host:8099
# PINOT_SERVER_URL=http://server-host:8097
# PINOT_MINION_URL=http://minion-host:9514

# PINOT_CONTROLLER_SSL=0
# PINOT_BASIC_AUTH=0
# PINOT_USER=admin
# PINOT_PASSWORD=admin

# PINOT_SKIP_INGEST=0
# PINOT_TABLE=odp_pinot_smoke
# PINOT_KEEP_TABLE=0
# PINOT_TIMEOUT_SECONDS=180
# PINOT_POLL_SECONDS=3
# PINOT_EXPECTED_COUNT=3
