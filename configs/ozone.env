#
# Used by ./ozone-sample-smoke.sh
# Everything here is optional; the script discovers it from Ambari and ozone-site.xml.

# ODP ships an empty shared /etc/hadoop-ozone/conf/ozone-site.xml, so the script
# falls back to the first per-role conf dir that declares ozone.om.service.ids.
# OZONE_CONF_DIR=/etc/hadoop-ozone/conf/ozone.om

# OZONE_BIN=/usr/odp/current/ozone-client/bin/ozone
# JAVA_HOME=/usr/lib/jvm/java-1.8.0-openjdk

# Kerberos. The Ozone headless keytab normally holds hdfs-<cluster>.
# OZONE_KEYTAB=/etc/security/keytabs/ozone.headless.keytab
# OZONE_PRINCIPAL=hdfs-mycluster
# OZONE_SKIP_KINIT=0

# OZONE_SERVICE_ID=omservice
# OZONE_VOLUME=odpsmokevol1234567890
# OZONE_BUCKET=smokebucket
# OZONE_KEY=smoke-key

# OZONE_KEEP_DATA=0
# OZONE_SKIP_HTTP=0
# OZONE_SKIP_FS=0
# CURL_EXTRA_OPTS=-k
