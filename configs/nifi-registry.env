#
# Used by ./nifi-registry-sample-smoke.sh
# Everything here is optional; the script discovers it from Ambari.

# Skip Ambari discovery of the Registry host / port / TLS flag.
# NIFI_REGISTRY_URL=http://nifi-registry-host:61080
# NIFI_REGISTRY_URL=https://nifi-registry-host:61443

# SPNEGO is only used when NIFI_REGISTRY_URL is https.
# NIFI_REGISTRY_SKIP_KINIT=1
# NIFI_REGISTRY_KEYTAB=/etc/security/keytabs/nifi-registry.service.keytab
# NIFI_REGISTRY_PRINCIPAL=nifiregistry/nifi-registry-host

# NIFI_REGISTRY_SKIP_WRITE=0
# NIFI_REGISTRY_KEEP_DATA=0
# NIFI_REGISTRY_BUCKET=odp_smoke_bucket
# NIFI_REGISTRY_FLOW=odp_smoke_flow

# CURL_EXTRA_OPTS=-k
