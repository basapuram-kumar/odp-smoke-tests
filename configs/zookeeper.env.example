# Copy to zookeeper.env (gitignored) and adjust if needed.
#   cp configs/zookeeper.env.example configs/zookeeper.env
#
# Used by ./zookeeper-sample-smoke.sh
# Everything here is optional; the script discovers it from Ambari
# (ZOOKEEPER service: ZOOKEEPER_SERVER hosts, zoo.cfg clientPort,
# admin.serverPort, admin.enableServer and 4lw.commands.whitelist).

# Skip Ambari discovery of the ensemble. Space- or comma-separated hostnames.
# ZOOKEEPER_HOSTS=host1 host2 host3
# ZOOKEEPER_CLIENT_PORT=2181

# Full client connection string. Built from the two settings above by default.
# ZOOKEEPER_CONNECT=host1:2181,host2:2181,host3:2181

# Four-letter words the servers accept. Read from the rendered zoo.cfg, then
# Ambari. A command that is not listed is reported SKIPPED, not FAIL. "*" means
# everything is allowed.
# ZOOKEEPER_4LW_WHITELIST=*

# AdminServer HTTP endpoint. ZooKeeper defaults to 8080, which collides with
# Ambari, so ODP moves it (8081 here). Set ZOOKEEPER_SKIP_ADMIN=1 to skip the
# check entirely; admin.enableServer=false is detected and reported SKIPPED.
# ZOOKEEPER_ADMIN_PORT=8081
# ZOOKEEPER_SKIP_ADMIN=0

# zkCli.sh data path (create / get / set / ls / delete on a throwaway znode).
# ZOOKEEPER_SKIP_CLI=0
# ZOOKEEPER_CLI_BIN=/usr/odp/current/zookeeper-client/bin/zkCli.sh
# ZOOKEEPER_ZNODE=/odp_zk_smoke_manual
# ZOOKEEPER_KEEP_ZNODE=0
# ZOOKEEPER_CLI_TIMEOUT=90

# The shipped zookeeper_client_jaas.conf uses useTicketCache=true, so the CLI
# needs a ticket in the cache. Any principal works because the root znode is
# world:anyone; the smoke user is just the least privileged one available.
# ZOOKEEPER_SKIP_KINIT=0
# ZOOKEEPER_KEYTAB=/etc/security/keytabs/smokeuser.headless.keytab
# ZOOKEEPER_PRINCIPAL=ambari-qa-<cluster>

# The ODP zkCli.sh wrapper needs JAVA_HOME under a bare sudo. Resolved from the
# ambari-agent command JSON, then /usr/lib/jvm, then java on PATH.
# JAVA_HOME=/usr/lib/jvm/java-1.8.0-openjdk

# Top-level znodes that must exist, otherwise the check is a FAIL. Unset by
# default: which service znodes exist depends on what is installed, so the
# script only reports the ones it finds unless you pin a list here.
# ZOOKEEPER_EXPECTED_ZNODES=/hbase-secure /infra-solr /brokers /hiveserver2 /rmstore

# Allowed spread in zk_znode_count between ensemble members. Non-zero because
# the servers are sampled one after another on a live cluster.
# ZOOKEEPER_ZNODE_COUNT_TOLERANCE=25

# Seconds to wait for a four-letter word reply.
# ZOOKEEPER_4LW_TIMEOUT=5

# CURL_EXTRA_OPTS=
