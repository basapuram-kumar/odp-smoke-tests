# Copy to zeppelin.env (gitignored) and set real values.
#   cp configs/zeppelin.env.example configs/zeppelin.env
#
# Used by ./zeppelin-editors-smoke.sh

ZEPPELIN_USER=admin
ZEPPELIN_PASSWORD=admin

# Optional: skip Ambari discovery of ZEPPELIN_MASTER + port
# ZEPPELIN_BASE_URL=http://zeppelin-host:9995

# Optional filters:
# ZEPPELIN_ONLY_GROUPS=md,sh,angular
# ZEPPELIN_SKIP_GROUPS=jdbc,livy
# ZEPPELIN_SKIP_INTERPS=livy.shared,sh.terminal
# ZEPPELIN_FAIL_ON_ERROR=1
