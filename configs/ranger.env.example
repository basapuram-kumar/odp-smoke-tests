# Copy to ranger.env (gitignored) and edit for your cluster.
# Used by Ranger REST scripts:
#   ranger-yarn-all-queue-users-add.sh
#   ranger-plugin-connection-smoke.sh
#   ranger-kms-sample-smoke.sh
#
# Lab default password (override per cluster as needed):
RANGER_USER=admin
RANGER_PASSWORD=Acceldata@01

# Optional: skip Ambari discovery
# RANGER_BASE_URL=http://ranger-admin-host:6080

# Optional defaults for ./ranger-yarn-all-queue-users-add.sh
# RANGER_YARN_SERVICE_NAME=ub20j11p3_yarn
# RANGER_ADD_USERS=registry,flink

# Optional filters for ./ranger-plugin-connection-smoke.sh
# RANGER_SERVICE_TYPES=hdfs,yarn,hive
# RANGER_SKIP_TYPES=tag
# RANGER_SKIP_SERVICES=o2009c1_knox
# RANGER_FAIL_ON_ERROR=1
