# Copy to airflow.env (gitignored) and adjust if needed.
#   cp configs/airflow.env.example configs/airflow.env
#
# Used by ./airflow-sample-smoke.sh

# Optional: skip Ambari discovery of AIRFLOW_WEBSERVER host
# AIRFLOW_BASE_URL=http://airflow-host:8889

# Install root (venv + airflow.cfg + dags/)
# AIRFLOW_HOME=/usr/odp/current/airflow

# AIRFLOW_DAG_ID=odp_airflow_smoke
# AIRFLOW_TIMEOUT_SECONDS=300
# AIRFLOW_SKIP_KINIT=0
