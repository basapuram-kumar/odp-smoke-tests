#
# Used by ./ranger-kms-sample-smoke.sh
# Everything here is optional; the script discovers KMS from Ambari / core-site.

# Skip Ambari discovery when set:
# KMS_PROVIDER=kms://http@kms-host.example.com:9292/kms

# Or build the provider from hosts + port:
# KMS_HOSTS=kms1.example.com kms2.example.com
# KMS_PORT=9292
# KMS_SSL=0

# Kerberos. Key lifecycle needs keyadmin (rangerkms/<FQDN>).
# EZ createZone uses hdfs; EZ put/get uses ambari-qa because dbks-site
# blacklists hdfs for DECRYPT_EEK. Set configs/ranger.env so the script can
# grant ambari-qa a temporary Ranger KMS decrypt policy.
# KMS_KEYTAB=/etc/security/keytabs/rangerkms.service.keytab
# KMS_PRINCIPAL=rangerkms/kms-host.example.com@REALM
# KMS_HDFS_KEYTAB=/etc/security/keytabs/hdfs.headless.keytab
# KMS_HDFS_PRINCIPAL=hdfs-mycluster
# KMS_CLIENT_KEYTAB=/etc/security/keytabs/smokeuser.headless.keytab
# KMS_CLIENT_PRINCIPAL=ambari-qa-mycluster
# KMS_CLIENT_USER=ambari-qa
# KMS_SKIP_KINIT=0
# KMS_SKIP_RANGER_POLICY=0
# KMS_POLICY_WAIT_SECONDS=45

# Key + encryption zone:
# KMS_KEY_NAME=odp_kms_smoke
# KMS_KEY_SIZE=256
# KMS_CIPHER=AES/CTR/NoPadding
# KMS_EZ_PATH=/tmp/odp_kms_smoke_ez
# KMS_SKIP_EZ=0
# KMS_SKIP_ROLL=0
# KMS_SKIP_HTTP=0
# KMS_KEEP_KEY=0

# CURL_EXTRA_OPTS=-k
