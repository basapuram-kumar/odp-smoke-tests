{
  "type": "index_parallel",
  "spec": {
    "dataSchema": {
      "dataSource": "odp_druid_smoke",
      "timestampSpec": {
        "column": "ts",
        "format": "iso"
      },
      "dimensionsSpec": {
        "dimensions": ["label"]
      },
      "metricsSpec": [
        {
          "type": "count",
          "name": "count"
        }
      ],
      "granularitySpec": {
        "type": "uniform",
        "segmentGranularity": "DAY",
        "queryGranularity": "NONE",
        "intervals": ["2024-01-01/2024-01-02"],
        "rollup": true
      }
    },
    "ioConfig": {
      "type": "index_parallel",
      "inputSource": {
        "type": "inline",
        "data": "ts,label\n2024-01-01T00:00:00.000Z,alpha\n2024-01-01T01:00:00.000Z,beta\n2024-01-01T02:00:00.000Z,gamma\n"
      },
      "inputFormat": {
        "type": "csv",
        "findColumnsFromHeader": true
      },
      "appendToExisting": false
    },
    "tuningConfig": {
      "type": "index_parallel",
      "maxNumConcurrentSubTasks": 1
    }
  }
}
